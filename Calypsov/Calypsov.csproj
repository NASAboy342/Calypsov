<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<Platforms>AnyCPU</Platforms>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- Single source of truth for the app's version (SemVer) — the SDK derives
		     AssemblyVersion/FileVersion/InformationalVersion from this automatically.
		     See Calypsov/PROJECT_README.md's "Versioning & Releases" section for the release recipe. -->
		<Version>1.1.0</Version>
		<!-- Without this, the SDK appends "+<git-commit-sha>" to InformationalVersion automatically,
		     which is what AppUpdateService reads to show the user their version — keep it a clean SemVer string. -->
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
   		<!-- Generate embedded file manifest when using the Photino.NET StaticFileServer -->
		<GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
		<!-- Windows Explorer / taskbar icon for the built executable -->
		<ApplicationIcon>AppIcon\app.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="8.0.10" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="Photino.NET" Version="3.2.3" />
		<PackageReference Include="Photino.NET.Server" Version="3.0.11" />
		<PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.0.0" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Resources\**" />
	</ItemGroup>

	<ItemGroup>
	  <None Update="wwwroot\**">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </None>
	  <!-- Loose copy needed at runtime: PhotinoWindow.SetIconFile() (Windows/Linux window icon)
	       requires an actual file path, not an embedded resource. -->
	  <None Update="AppIcon\**">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Helpers/" />
	</ItemGroup>

</Project>
